{
  "name": "@parche/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "API de PARCHE Studio (Fastify + Prisma + MySQL + Redis).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "seed:clear-demo": "tsx prisma/seed.ts --clear-demo"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@prisma/client": "^6.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

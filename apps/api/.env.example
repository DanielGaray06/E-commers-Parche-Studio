# ---------------------------------------------------------------------------
# API de PARCHE Studio — variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas el `.env` real al repositorio.
# ---------------------------------------------------------------------------

# MySQL local (instalado con Scoop o vía Docker)
DATABASE_URL="mysql://parche:parche@127.0.0.1:3306/parche_studio"

# Redis local (caché del catálogo y límite de intentos de login)
REDIS_URL="redis://127.0.0.1:6379"

# Puerto de la API
PORT=3001
HOST=127.0.0.1

# Orígenes permitidos (tienda y panel en desarrollo)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Clave para firmar las sesiones del panel.
# Genera una propia con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
JWT_EXPIRES_IN="12h"

# Usuario administrador que crea el comando `pnpm db:seed`
ADMIN_EMAIL="admin@parche.studio"
ADMIN_PASSWORD="Parche2026*"
ADMIN_NAME="Administrador"
